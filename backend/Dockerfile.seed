# syntax=docker/dockerfile:1
# One-off seed task: loads the problems baked into the image (idempotent).
# The problems come from a named build context:
#   docker build -f backend/Dockerfile.seed --build-context problems=tests/golden backend
# Without it the "problems" stage below is empty and the seed fails on purpose.

FROM scratch AS problems

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
WORKDIR /src

COPY go.* ./
RUN go mod download

COPY . .

ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w" -o /out/seed ./cmd/seed

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/seed /seed
COPY --from=problems . /problems
USER 65532:65532
ENTRYPOINT ["/seed", "-dir", "/problems"]
