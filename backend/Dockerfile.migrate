# syntax=docker/dockerfile:1
# One-off migration task: applies backend/migrations before a deploy (expand/contract).
#
# The Atlas CLI is built here from source, the community edition at the commit of the
# arigaio/atlas:1.3.10-community image: every published Atlas image failed the Grype gate
# (the official build bundles brotli 1.2.0, GO-2026-6888; both builds use golang.org/x/net
# 0.55.0, GO-2026-6612). Building it ourselves pins the Go toolchain and raises x/net to
# the version the backend uses. Revisit when a published image is clean.

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG ATLAS_COMMIT=90dacfc6c25f151fc3d48fdba150c677e9dddf1d
ARG ATLAS_VERSION=v1.3.10
ADD https://github.com/ariga/atlas.git#${ATLAS_COMMIT} /src
WORKDIR /src/cmd/atlas
RUN go get golang.org/x/net@v0.62.0

ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath \
    -ldflags "-s -w -X ariga.io/atlas/cmd/atlas/internal/cmdapi.version=${ATLAS_VERSION}" \
    -o /out/atlas .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/atlas /atlas
COPY migrations /migrations
COPY deploy/atlas.hcl /atlas.hcl
ENV DB_SSLMODE=require
USER 65532:65532
ENTRYPOINT ["/atlas"]
CMD ["migrate", "apply", "--env", "deploy", "--config", "file:///atlas.hcl"]
