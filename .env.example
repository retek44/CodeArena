# Local development values. Copy to .env (gitignored).
PORT=8080
# dev trusts the X-Dev-User header (local only); cognito for AWS
AUTH_MODE=dev
# AUTH_MODE=cognito needs these (Terraform outputs cognito_issuer, cognito_client_id)
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
DATABASE_URL=postgres://codearena:codearena@localhost:5432/codearena?sslmode=disable
VALKEY_ADDR=localhost:6379
AWS_REGION=eu-central-1
